# =============================================================================
# Kitchen Pilot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Core ---
DATABASE_URL=postgresql+asyncpg://kitchen:kitchen@localhost:5432/kitchen_pilot
LITELLM_BASE_URL=http://localhost:4000
OLLAMA_BASE_URL=http://localhost:11434

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Google OAuth (for Calendar + Drive MCP) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/auth/google/callback

# --- Nutrition Provider ---
# Get a free key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# --- Search MCP (optional, pick one) ---
# Brave: https://brave.com/search/api/
BRAVE_API_KEY=
# Tavily: https://tavily.com/
TAVILY_API_KEY=
